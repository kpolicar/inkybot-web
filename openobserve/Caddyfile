openobserve.inkybot.me {

    # Claude full-access — bypasses the firewall entirely
    @claude_access {
        header Authorization "Basic ***REMOVED***"
    }
    handle @claude_access {
        request_header Authorization "Basic ***REMOVED***"
        @grpc protocol grpc
        reverse_proxy @grpc h2c://openobserve:5081
        reverse_proxy openobserve:5080
    }

    # Everything else — write-only firewall as before
    handle {
        @public_token_abuse {
            header Authorization "Basic ***REMOVED***"
            not path /api/*/*/_json /api/*/*/_bulk /api/*/*/_multi /api/*/v1/logs /api/*/v1/metrics /api/*/v1/traces /opentelemetry.*
        }
        respond @public_token_abuse "Forbidden: Token is strictly write-only." 403

        @grpc protocol grpc
        reverse_proxy @grpc h2c://openobserve:5081
        reverse_proxy openobserve:5080
    }
}
